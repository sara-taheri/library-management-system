# Library Management System - environment configuration
# Copy this file to `.env` and adjust the values. All variables have
# safe development defaults, but SECRET_KEY must be set in production.

# Secret used to sign session cookies (REQUIRED in production).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Where the app runs: development | production
ENVIRONMENT=development

# Default loan window in days (due date = borrow date + LOAN_PERIOD_DAYS)
LOAN_PERIOD_DAYS=14

# Database URL. When unset, defaults to <repository>/data/library.db (SQLite).
# Examples:
#   DATABASE_URL=sqlite:///./data/library.db
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/library
# DATABASE_URL=
